NODE_ENV=development
PORT=3001

# Local PostgreSQL connection. Replace with your own database credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assetpass

# Set DB_SSL=true only when your PostgreSQL provider requires TLS.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication
# Generate a unique secret using: openssl rand -hex 32
# Never use this example value as a production secret.
JWT_ACCESS_SECRET=REPLACE_THIS_EXAMPLE_VALUE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS
JWT_ACCESS_ISSUER=assetpass-api
JWT_ACCESS_AUDIENCE=assetpass-app
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

APP_ORIGIN=http://localhost:3000

# Transactional email delivery. Brevo is the temporary default; Resend remains supported.
# Keep credentials in deployment environment variables, never in source control.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_NAME=Nexus Hub
BREVO_SENDER_EMAIL=khlestakov.james@gmail.com

# Optional when EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=

# Private Neon Object Storage for asset evidence (optional until credentials are configured).
# Create an S3 access key in the Neon Console; never commit real credentials.
ASSET_STORAGE_ENDPOINT=https://br-holy-hall-b99vyw51.storage.c-7.eu-central-1.aws.neon.tech
ASSET_STORAGE_REGION=eu-central-1
ASSET_STORAGE_ACCESS_KEY_ID=REPLACE_WITH_NEON_STORAGE_ACCESS_KEY_ID
ASSET_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_NEON_STORAGE_SECRET_ACCESS_KEY
ASSET_EVIDENCE_BUCKET=asset-evidence
